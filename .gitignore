# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source photography — full-resolution camera/drone originals (~27MB).
# Not needed to build: `src/photos/` holds the committed, web-ready
# derivatives and is what the site actually imports. These are only the
# masters for re-running `npm run prep-images`. Keep your own backup.
/originals

# Netlify CLI writes .netlify/state.json when you link or create a site.
# It is machine-local and must not be committed.
/.netlify

# scroll-craft working files. Raw generations (out/), the harness's
# screenshot runs (lab/, gigabytes) and the encode staging folder (assets/,
# a copy of what ships in public/walk). The brief, tools and the fingerprint
# registry are committed; these are regenerable or already shipped.
/scrollcraft/builds/*/out
/scrollcraft/builds/*/lab
/scrollcraft/builds/*/assets
